      "col_business_name": "C",
      "col_gross_volume": "E",
      "col_paydiversenet": "AF",
      "skip_header_rows": 1,
      "_notes": "AF=SPLIT TO AGENT (PayDiverse share). File in Breier/ subfolder each month. Negatives from chargebacks must be preserved."
